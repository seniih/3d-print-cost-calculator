# Copy to `.env` and adjust. Every value here is optional for local use.

# --- Database ---------------------------------------------------------------
# Only needed when running with `pnpm dev` (docker compose sets it for you).
# `pnpm db:up` starts a matching Postgres in Docker.
DATABASE_URL=postgresql://printcost:printcost@localhost:5432/printcost

# --- Public URL ---------------------------------------------------------------
# The address people use to reach the app. Used for sign-in redirects.
BETTER_AUTH_URL=http://localhost:3000

# --- Sign-in (optional) -------------------------------------------------------
# Leave all of these empty to run in LOCAL MODE: no sign-in, one built-in user.
# Fill in at least one provider to run in PUBLIC MODE: guests can calculate,
# and signed-in users keep their data on every device.
#
# Required in public mode. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
