// 3D Print Cost Calculator — database schema
//
// Conventions
// - Money is stored as Decimal(12, 4) in the owner's currency (UserSettings.currency).
// - Every user-owned row carries `userId` and is deleted with its user.
// - A Calculation stores a full, versioned snapshot of its inputs and result as
//   JSON, so editing a printer or filament later never rewrites history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth). Field names must match what Better Auth expects.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAnonymous   Boolean?  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  settings     UserSettings?
  printers     Printer[]
  filaments    Filament[]
  extraItems   ExtraItem[]
  products     Product[]
  calculations Calculation[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum Currency {
  TRY
  USD
  EUR
}

enum ProfitMode {
  MARKUP // price = cost × (1 + p)
  MARGIN // profit is p of the net price
}

enum FilamentMaterial {
  PLA
  PETG
  ABS
  ASA
  TPU
  NYLON
  PC
  CF_COMPOSITE
  RESIN
  OTHER
}

enum ExtraItemCategory {
  HARDWARE // keyring, magnet, heat-set insert, screw
  CONSUMABLE // glue stick, adhesive, paint, sandpaper
  PACKAGING // box, bag, label
  OTHER
}

enum ExtraItemUnit {
  PIECE
  GRAM
  MILLILITER
  CENTIMETER
  PACK
}

/// Per-user defaults used to prefill every new calculation.
model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency Currency @default(USD)

  electricityPricePerKwh Decimal @default(0) @db.Decimal(12, 4)
  laborRatePerHour       Decimal @default(0) @db.Decimal(12, 4)

  // Percentages are stored as plain numbers: 10 means 10 %.
  filamentWastePct  Decimal    @default(0) @db.Decimal(6, 2)
  failureRatePct    Decimal    @default(5) @db.Decimal(6, 2)
  overheadPct       Decimal    @default(0) @db.Decimal(6, 2)
  profitMode        ProfitMode @default(MARKUP)
  profitPct         Decimal    @default(30) @db.Decimal(6, 2)
  taxRatePct        Decimal    @default(0) @db.Decimal(6, 2)
  marketplaceFeePct Decimal    @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Printer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  brand String?
  model String?

  purchasePrice          Decimal @db.Decimal(12, 4)
  /// What the printer can be sold for at the end of its life.
  resaleValue            Decimal @default(0) @db.Decimal(12, 4)
  /// Expected useful life in print hours, used for depreciation.
  lifetimeHours          Int
  /// Average power draw while printing.
  powerWatts             Int
  /// Nozzles, build plates, belts, lubricant… spread per print hour.
  maintenanceCostPerHour Decimal @default(0) @db.Decimal(12, 4)

  isDefault  Boolean   @default(false)
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("printer")
}

model Filament {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  brand    String?
  material FilamentMaterial @default(PLA)
  color    String?
  colorHex String?

  spoolPrice       Decimal @db.Decimal(12, 4)
  /// Net filament weight on the spool, without the spool itself.
  spoolWeightGrams Int     @default(1000)

  isDefault  Boolean   @default(false)
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("filament")
}

/// Anything besides filament that goes into a print: keyrings, magnets,
/// inserts, glue, paint, packaging…
model ExtraItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  category  ExtraItemCategory @default(HARDWARE)
  unit      ExtraItemUnit     @default(PIECE)
  unitPrice Decimal           @db.Decimal(12, 4)

  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("extra_item")
}

model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// A small JPEG thumbnail as a data URL, resized in the browser before upload.
  imageData String?

  calculations Calculation[]

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("product")
}

model Calculation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name     String
  quantity Int      @default(1)
  currency Currency

  /// Versioned snapshot of every input (see src/lib/calculator/schema.ts).
  inputs        Json
  inputsVersion Int  @default(1)
  /// Full cost breakdown produced by the calculation engine.
  result        Json

  // Denormalised totals for fast listing and sorting.
  unitCost       Decimal @db.Decimal(12, 4)
  totalCost      Decimal @db.Decimal(12, 4)
  suggestedPrice Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([productId])
  @@map("calculation")
}
